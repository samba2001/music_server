APP_NAME=Music Server API
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./music_server.db
JWT_SECRET_KEY=replace-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MEDIA_ROOT=media/songs
# Set this to the OAuth web client ID used by the frontend.
GOOGLE_CLIENT_ID=
DOWNLOAD_TIMEOUT_SECONDS=300
