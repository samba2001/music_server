{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: FastAPI (uv)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload"
            ],
            "jinja": true,
            "python": "${workspaceFolder}/.venv/bin/python"
        }
    ]
}